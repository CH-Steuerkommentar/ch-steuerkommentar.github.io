---
// Kopf links: Werkname (Link zur Startseite), auf allen Seiten am gleichen Ort.
// Startseite: ILE-Logo (Link zur Website des ILE-HSG) – neben dem Werknamen mit Trennstrich wie auf den übrigen Seiten. Übrige Seiten: ILE-Logo neben dem Werknamen, Teil des Startseiten-Links.
import logo from '../assets/ile-logo.png';
const route = Astro.locals.starlightRoute;
const start = route?.siteTitleHref ?? import.meta.env.BASE_URL;
const istStart = route?.entry?.id === 'index' || route?.entry?.data?.template === 'splash';
const alt = 'Universität St.Gallen – Institute for Law and Economics';
const fr = route?.locale === 'fr';
const werk = fr ? ['Encyclopédie de droit fiscal ', 'de Saint-Gall'] : ['St. Galler ', 'Steuerrechtsenzyklopädie'];
const zurStart = fr ? 'Encyclopédie de droit fiscal de Saint-Gall – page d\'accueil' : 'St. Galler Steuerrechtsenzyklopädie – zur Startseite';
---
{istStart ? (
  <>
    <a class="kopf kopf-link" href={start}>
      <span class="kopf-werk"><span>{werk[0]}</span><span>{werk[1]}</span></span>
    </a>
    <span class="kopf-trenner kopf-trenner-start" aria-hidden="true"></span>
    <a class="kopf-start" href="https://ile.unisg.ch/de/" target="_blank" rel="noopener" aria-label="Institut für Law and Economics der Universität St.Gallen (neuer Tab)">
      <img class="kopf-logo" src={logo.src} width="140" height="40" alt={alt} />
    </a>
  </>
) : (
  <a class="kopf kopf-link" href={start} aria-label={zurStart}>
    <span class="kopf-werk"><span>{werk[0]}</span><span>{werk[1]}</span></span>
    <span class="kopf-trenner" aria-hidden="true"></span>
    <img class="kopf-logo" src={logo.src} width="140" height="40" alt={alt} />
  </a>
)}
