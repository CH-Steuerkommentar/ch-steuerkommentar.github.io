---
// Erzwingt die helle Ansicht, unabhängig von Systemeinstellung und früherer Wahl.
---
<script is:inline>
  document.documentElement.dataset.theme = 'light';
  try { localStorage.removeItem('starlight-theme'); } catch (e) {}
</script>
<style is:global>
  :root { color-scheme: light; }
  /* Tastenkürzel-Hinweis im Suchfeld ausblenden; Strg+F bleibt die Suche des Browsers */
  site-search button[data-open-modal] > kbd { display: none !important; }
</style>
