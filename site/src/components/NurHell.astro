---
// Erzwingt die helle Ansicht, unabhängig von Systemeinstellung und früherer Wahl.
---
<script is:inline>
  document.documentElement.dataset.theme = 'light';
  try { localStorage.removeItem('starlight-theme'); } catch (e) {}
  // Jeder Link zu einer anderen Website öffnet in einem neuen Tab, auch nachträglich erzeugte (Suche)
  document.addEventListener('click', (e) => {
    const a = e.target.closest && e.target.closest('a[href]');
    if (a && /^https?:/.test(a.href) && a.host !== location.host) { a.target = '_blank'; a.rel = 'noopener'; }
  }, true);
  document.addEventListener('DOMContentLoaded', () => {
    // Links zu anderen Websites (Entscheide, Materialien, Literatur) im neuen Tab öffnen
    document.querySelectorAll('a[href^="http"]').forEach((a) => {
      if (a.host !== location.host) { a.target = '_blank'; a.rel = 'noopener'; }
    });
    // Zitiervorschlag kopieren
    document.querySelectorAll('button.kopieren').forEach((b) => {
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.text); b.textContent = b.dataset.ok || 'Kopiert'; }
        catch (e) { b.textContent = document.documentElement.lang.startsWith('fr') ? 'Sélectionner' : 'Bitte markieren'; }
        setTimeout(() => { b.textContent = b.dataset.label || 'Kopieren'; }, 1800);
      });
    });
  });
</script>
<style is:global>
  :root { color-scheme: light; }
  /* Tastenkürzel-Hinweis im Suchfeld ausblenden; Strg+F bleibt die Suche des Browsers */
  site-search button[data-open-modal] > kbd { display: none !important; }
</style>
